desktop/src-tauri/target/
desktop/src-tauri/gen/

# --- OS / IDE ---
.DS_Store
.idea/
.vscode/

# --- Нагрузочные прогоны (07 §3): k6 пишет сводку в cwd ---
summary.json
tests/load/*.ndjson

# Локальные разборы и отчёты проверок — в историю не входят
analysis-check/

# Карта знаний graphify: 21 МБ graph.json + кэш. Строится локально, в бой не едет.
graphify-out/

# Версию шлюза пишет gateway/deploy.sh перед rsync — это не исходник.
gateway/VERSION
