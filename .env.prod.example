# ============================================================================
# LeadChat — переменные окружения ПРОДА (docs/05-DEPLOY-OPS.md §4).
#
#   ЭТОТ ФАЙЛ — ШАБЛОН. РЕАЛЬНЫЙ .env В GIT НЕ ПОПАДАЕТ НИКОГДА.
#
# Установка на сервере:
#   scp .env.prod.example deploy@<vps>:/opt/leadchat/.env
#   ssh deploy@<vps> 'chmod 600 /opt/leadchat/.env && nano /opt/leadchat/.env'
#
# Все секреты генерируются командой, указанной рядом с переменной.
# Копию заполненного файла — в менеджер секретов компании: без TOKEN_ENC_KEY
# бэкап БД бесполезен (токены Авито не расшифруются, 05 §6.4).
#
# Имена переменных — контракт (их читают Compose, app/core/config.py, CI и
# runbook). Переименовывать нельзя.
# ============================================================================

# --- Общее ------------------------------------------------------------------
ENV=production                    # production | staging | development
DOMAIN=chat.partner-lead-centre.ru
LOG_LEVEL=INFO                    # DEBUG в проде запрещён (утечёт лишнее в логи)
TZ=UTC                            # всё в UTC; отображение МСК — забота фронтенда

# Публичная база URL этого деплоя: из неё строятся URL вебхука Авито
# (PUBLIC_BASE_URL + /api/hooks/avito/{id}) и OAuth-callback (DESIGN §8.3).
PUBLIC_BASE_URL=https://chat.partner-lead-centre.ru

# База URL ФРОНТЕНДА: сюда бэкенд редиректит после OAuth-callback Авито и любых
# других возвратов в UI (хвост спринта 2). В проде фронт и API на одном домене,
# поэтому значение совпадает с PUBLIC_BASE_URL; в dev — http://localhost:5173.
FRONTEND_BASE_URL=https://chat.partner-lead-centre.ru

# CORS: пусто — SPA и API на одном origin, кросс-доменных запросов нет (01 §1.1).
# Непустое значение в проде = дырка, заполнять только осознанно.
CORS_ORIGINS=

# --- Образы -----------------------------------------------------------------
# Пространство имён GHCR: должно совпадать с владельцем GitHub-репозитория
# (см. .github/workflows/deploy.yml). Единственное место, где оно задано.
GHCR_NAMESPACE=ghcr.io/lead-partner
# Тег образов. Строку правит deploy.sh при каждой выкатке — руками не трогать.
IMAGE_TAG=latest

# --- PostgreSQL -------------------------------------------------------------
POSTGRES_DB=leadchat
POSTGRES_USER=leadchat
# openssl rand -base64 24 | tr -d '/+=' | head -c 24
POSTGRES_PASSWORD=CHANGE_ME
# async-драйвер обязателен (SQLAlchemy 2 async, DESIGN §2).
# Пароль обязан совпадать с POSTGRES_PASSWORD выше — это две разные строки,
# рассинхрон здесь даёт «падает api, а postgres здоров».
DATABASE_URL=postgresql+asyncpg://leadchat:CHANGE_ME@postgres:5432/leadchat
DB_POOL_SIZE=10                   # на процесс; api+worker+scheduler < max_connections=120
DB_MAX_OVERFLOW=5                 # временные соединения сверх пула на всплеске
DB_POOL_TIMEOUT_SECONDS=30        # ждать свободное соединение, потом ошибка (не вечный await)
# ⚠ 7200, А НЕ 1800 (замер 06.09). Каждое новое соединение платит 40–62 мс
# планирования на первом запросе к `messages`: в каталоге 28 партиций. При
# 1800 с пул переоткрывался ~80 раз в час — столько же холодных стартов на
# ровном месте. От молча убитого firewall'ом соединения страхует
# pool_pre_ping, а не короткий срок жизни.
DB_POOL_RECYCLE_SECONDS=7200
# Прод-страховка от «idle in transaction» (05 §8): PostgreSQL сам гасит бэкенд,
# если транзакция висит без активности дольше этого времени. 0 = выключено.
DB_IDLE_IN_TRANSACTION_TIMEOUT_MS=300000
DB_STATEMENT_TIMEOUT_MS=0         # 0 = без ограничения (миграции и бэкфилл бывают долгими)

# --- Redis ------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0
# один инстанс; «логические» применения разделяем префиксами ключей, НЕ разными db

# --- Автораспределение обращений (docs/18) ----------------------------------
# Обращение само уходит наименее загруженному оператору, который СЕЙЧАС в сети
# и назначен на этот канал. Не нашлось такого — диалог остаётся в очереди
# «Входящие» ровно как раньше: распределение это слой НАД очередью, а не
# вместо неё, и его выключение не ломает ничего.
DISTRIBUTION_ENABLED=false
# Потолок одновременных диалогов на оператора. Закрытые не считаются: иначе
# закрывший за смену тридцать обращений к обеду выглядел бы самым занятым.
DISTRIBUTION_MAX_ACTIVE=5

# --- Авито OAuth (кабинет developers.avito.ru) ------------------------------
AVITO_CLIENT_ID=CHANGE_ME
AVITO_CLIENT_SECRET=CHANGE_ME
# ПЕРЕКЛЮЧЕНИЕ С МОКА НА БОЕВОЙ АВИТО — ровно эти две строки (см. RUNBOOK §9):
AVITO_API_BASE=https://api.avito.ru
AVITO_AUTH_URL=https://avito.ru/oauth
# callback обязан совпадать с указанным в кабинете разработчика Авито
AVITO_REDIRECT_URI=https://chat.partner-lead-centre.ru/api/v1/avito/callback

# --- Шифрование токенов Авито (DESIGN §1.5) ---------------------------------
# 32 байта base64 для AES-256-GCM.  openssl rand -base64 32
# Потеря ключа = переподключение ВСЕХ аккаунтов через OAuth (данные в БД целы).
# Хранить копию в менеджере секретов компании — обязательно.
TOKEN_ENC_KEY=CHANGE_ME

# --- Auth (DESIGN §9) -------------------------------------------------------
# openssl rand -base64 64 | tr -d '\n'
JWT_SECRET=CHANGE_ME
JWT_ACCESS_TTL_SECONDS=900        # 15 минут
REFRESH_TTL_DAYS=14

# --- AI и провайдеры адреса -------------------------------------------------
# Ключи DaData, Яндекса, контакт для OSM, ключи OpenRouter/Groq/Mistral и
# Anthropic на проде НЕ лежат с 16.09: все походы идут через шлюз на Амстердаме
# (GATEWAY_URL/GATEWAY_TOKEN ниже, docs/46-ШЛЮЗ-API.md), ключи — в его
# /opt/leadchat-gateway/.env. Anthropic: api.anthropic.com не обслуживает
# запросы из России — класть ли ключ на шлюз, решает владелец; без ключа шаг
# ai_answer штатно делает handoff(ai_unavailable).
# Сроки хранения журналов (планировщик, ночью): переписка не убирается никогда.
AUDIT_LOG_TTL_DAYS=365
MESSAGE_IDEMPOTENCY_TTL_DAYS=30
AI_MODEL_ANSWER=claude-sonnet-5
AI_MODEL_CLASSIFY=claude-haiku-4-5
AI_TIMEOUT_SECONDS=10
AI_MAX_TOKENS_ANSWER=1024
AI_MAX_TOKENS_CLASSIFY=256
# В проде — только 0. AI_FAKE=1 отвечает детерминированной заглушкой и не
# делает ни одного сетевого вызова (CI, локальная отладка, демо без ключа).
AI_FAKE=0

# --- Лид-бот как поставщик ответов на шаге ai_answer (docs/42) ---------------
# Отдельный продукт владельца на своём сервере: отвечает клиентам по своему
# регламенту (роутеры, ценовая лестница, RAG, эскалация с причиной и сроком).
# Подключается вместо Claude на шаге ai_answer — остальное поведение бота
# (замолкание при менеджере, расписание, handoff) не меняется.
#
# Эти две строки — ЗАПАСНЫЕ значения: адрес и токен хранятся в базе
# (app_settings, ключ leadbot; токен зашифрован) и меняются из интерфейса, без
# захода на сервер. Сброс настройки возвращает к тому, что задано здесь.
#
# ⚠ ЗАПОЛНЕННОСТЬ САМА ПО СЕБЕ НИЧЕГО НЕ ВКЛЮЧАЕТ. Поставщик выбирается у
# каждого бота отдельно (bots.ai_provider, по умолчанию claude). Так и задумано:
# у лид-бота другие цены и формулировки, и менять то, что читают клиенты, одной
# переменной окружения нельзя.
#
# Адрес — внутри моста, наружу порт не проброшен. Токен всё равно обязателен:
# туннель это транспорт, а не аутентификация. ТОЛЬКО ЛАТИНИЦА — заголовки HTTP
# не переносят кириллицу, и с русской «с» вместо латинской каждый диалог будет
# уходить человеку с невнятным «лид-бот недоступен».
LEADBOT_URL=                      # напр. http://10.10.0.2:8788
LEADBOT_TOKEN=                    # LEADBOT_SERVICE_TOKEN на стороне лид-бота

# --- Шлюз внешних API на Амстердаме (docs/46-ШЛЮЗ-API.md) ---
# Ключи DaData/Яндекса/OpenRouter/Groq/Mistral/Anthropic на проде НЕ лежат — они в
# /opt/leadchat-gateway/.env на Амстердаме. Пусто = помощники выключены целиком.
GATEWAY_URL=                      # http://10.10.0.2:8792 (адрес внутри моста)
GATEWAY_TOKEN=                    # тот же GATEWAY_TOKEN, что в /opt/leadchat-gateway/.env

# --- Media ------------------------------------------------------------------
MEDIA_ROOT=/var/leadchat/media

# --- Расшифровка голосовых (свой Whisper) ---
# Владелец выбирал между облаком и своим сервером и выбрал свой: «давай свой
# Whisper». Запись клиента никуда не уходит, считает ВОРКЕР, у нас остаётся
# только текст. Замер боя: 597 голосовых за 60 дней, около десяти в сутки.
#
# WHISPER_ENABLED=0 полностью выключает расшифровку: задача завершается сразу,
# ни модель, ни запись не трогаются. Локально это разумное значение — первое
# же голосовое качает 464 МБ весов.
WHISPER_ENABLED=1
WHISPER_MODEL=small
# Потоков счёта. Два из четырёх ядер: столько же, сколько квота контейнера
# воркера (cpus: 2.0). Больше — и cgroup замораживает контейнер целиком,
# вместе с приёмом вебхуков Авито, который живёт в этом же процессе.
WHISPER_CPU_THREADS=2
# Куда качаются веса. В образе их нет намеренно (464 МБ через тоннель на каждой
# выкатке); в проде сюда смонтирован постоянный том.
WHISPER_MODEL_DIR=/var/leadchat/whisper
# Записи длиннее порога не расшифровываются: потолок ARQ-задачи 300 с, и
# пятнадцатиминутную запись он убил бы на середине.
WHISPER_MAX_AUDIO_SECONDS=300
WHISPER_MAX_TRIES=3
MEDIA_MAX_SIZE_MB=20              # обязано совпадать с client_max_body_size в nginx
# Ключ подписи ссылок secure_link (05 §3.2/§3.3).  openssl rand -hex 32
# Читают ДВА сервиса: api (генерирует подпись) и nginx (проверяет).
# Смена ключа мгновенно инвалидирует все выданные ссылки на вложения —
# это нормально, фронт перезапросит деталь диалога и получит новые.
#
# ЗАГЛУШКУ НИЖЕ ОСТАВИТЬ НЕЛЬЗЯ, И ЭТО ТЕПЕРЬ ПРОВЕРЯЕТСЯ ДВАЖДЫ: выкатка
# останавливается на шаге 0б, а контейнер с ENV=production отказывается
# стартовать. Раньше не проверялось ничем: подстановка в docker-compose ловит
# только пустое значение, а непустой CHANGE_ME проходил насквозь — и раздача
# вложений оставалась открытой для всех, кто видел этот файл в репозитории.
MEDIA_SIGN_KEY=CHANGE_ME

# --- Мониторинг -------------------------------------------------------------
SENTRY_DSN=                       # DSN проекта leadchat-backend (api+worker+scheduler)
SENTRY_TRACES_SAMPLE_RATE=0.1
# push-URL монитора Uptime-Kuma для канарейки вебхуков (05 §7.2)
KUMA_WEBHOOK_CANARY_URL=
# Внешних каналов тревог у системы НЕТ — решение заказчика от 8 августа
# (docs/23-ALERTS-DECISION.md). Скрипты сообщают о находках двумя путями:
# строкой в свой лог и уведомлением в центр внутри системы — для второго
# нужен INTERNAL_SERVICE_TOKEN ниже.

# --- Бэкапы (читают deploy/backup.sh и backup-verify.sh) --------------------
# BACKUP_DIR обязан совпадать с тем, что смонтировано в postgres как /backups
BACKUP_DIR=/var/leadchat/backups
BACKUP_KEEP_DAILY=14              # локально: 14 суточных дампов
BACKUP_KEEP_OFFSITE_DAILY=30      # офсайт: 30 суточных
BACKUP_KEEP_OFFSITE_MONTHLY=12    # офсайт: 12 месячных (первое число месяца)
# Нижняя граница размера дампа (страховка от обрезанного файла). НЕ ставить
# «правдоподобные» мегабайты: дамп пустой схемы весит ~32 КБ, и порог в 1 МБ
# валит бэкап каждую ночь ещё до офсайта. Содержательную проверку делает
# оглавление pg_restore --list, см. deploy/backup.sh.
MIN_DUMP_BYTES=20000
# Настроенный remote rclone (S3-совместимый, географически отдельный от VPS);
# создаётся один раз командой `rclone config` от пользователя деплоя.
# ВАЖНО: <имя-бакета> должно реально существовать у провайдера — Timeweb S3
# выдаёт бакетам UUID-имена, а rclone с no_check_bucket=true бакет НЕ создаёт
# и молча падает с NoSuchBucket 404. Проверка: `rclone lsd offsite:`.
RCLONE_REMOTE=offsite:<имя-бакета>

# --- Тюнинг -----------------------------------------------------------------
WEB_CONCURRENCY=2                 # uvicorn-воркеров в контейнере api
ARQ_MAX_JOBS=50                   # параллельных задач в worker
RECONCILE_INTERVAL_SECONDS=300    # reconciliation-поллинг (DESIGN §1.3)
READ_MARKER_TTL_DAYS=90           # TTL хэша read:{user_id} (01 §5.1); продлевается на каждой записи

# --- Пороги /api/health/deep (05 §7.2) --------------------------------------
# Ниже порога — «yellow», на пороге и выше — «red» в общем status.
HEALTH_QUEUE_LEN_RED=1000         # длина очереди ARQ
HEALTH_OLDEST_PENDING_SEC_RED=300 # возраст самой старой pending-задачи
HEALTH_FAILED_LAST_HOUR_RED=10    # failed-доставок за час
# Окно тревоги по брошенным вебхукам (webhooks:avito:dlq — потерянные обращения
# клиентов). Порога по количеству НЕТ: красное с первой же записи, потому что
# одна потеря — это один несостоявшийся заказ. Гасит тревогу только время.
# Сутки, а не «пока dlq > 0»: поток никем не читается и не подрезается, счётчик
# только растёт, и вечно красный /deep — это Kuma, которая после первой потери
# перестаёт отличать упавшую БД от прошлогодней записи. Само число потерь из
# тела ответа не исчезает никогда (queue.dlq), истекает только тревога.
HEALTH_DLQ_FRESH_SEC_RED=86400
# В проде обязателен true: иначе мёртвый планировщик не попадёт в общий status.
HEALTH_DEEP_CHECK_SCHEDULER=true
SCHEDULER_HEARTBEAT_MAX_AGE_SECONDS=300

# --- Служебный вход для скриптов на хосте (14 §2.1) -------------------------
# Токен ручки POST /api/v1/internal/notify. Её зовут deploy/backup.sh,
# deploy/healthcheck-alert.sh и внешний наблюдатель со второго сервера, поэтому
# токен обязан лежать именно в /opt/leadchat/.env — скрипты читают файл целиком
# (`set -a; source "$ENV_FILE"`). Пусто = ручка выключена (401 всем).
#   echo "INTERNAL_SERVICE_TOKEN=$(openssl rand -hex 32)"
INTERNAL_SERVICE_TOKEN=CHANGE_ME
# Куда скрипты шлют событие. Ручка не должна торчать наружу (см. 14 §4):
# сервису api в docker-compose.prod.yml добавлен ports 127.0.0.1:8000, а nginx
# отдаёт на /api/v1/internal/ 404.
INTERNAL_NOTIFY_URL=http://127.0.0.1:8000/api/v1/internal/notify

# --- Внешний сторож (14 §2.1) -----------------------------------------------
# Тишина по аккаунту в рабочие часы → «важно» (критичной эта тревога
# похоронила две ночи без резервной копии). ЧЕТЫРЕ ЧАСА, А НЕ ПОЛЧАСА:
# порог подняли 9 августа в коде, а эта строка осталась старой и била его —
# см. MIN_INBOUND_STALL_MINUTES в app/scheduler/jobs/watchdog.py.
WATCHDOG_INBOUND_STALL_MINUTES=240
WATCHDOG_WORK_START_HOUR=9          # МСК: ночная тишина — норма, а не поломка
WATCHDOG_WORK_END_HOUR=21
WATCHDOG_QUEUE_BACKLOG_RED=         # пусто → HEALTH_QUEUE_LEN_RED
WATCHDOG_QUEUE_OLDEST_SEC_RED=      # пусто → HEALTH_OLDEST_PENDING_SEC_RED
WATCHDOG_DISK_USED_PCT_WARNING=85
WATCHDOG_DISK_USED_PCT_CRITICAL=95
# Заполнять, если /var/backups или медиа лежат на отдельном разделе: без пути
# сторож меряет раздел MEDIA_ROOT, а в контейнере это обычно «/».
WATCHDOG_DISK_PATH=
# Пусто → /etc/letsencrypt/live/${DOMAIN}/fullchain.pem. Каталог обязан быть
# смонтирован в контейнер scheduler (docker-compose.prod.yml), иначе проверка
# молчит и пишет info-строку watchdog.cert_file_absent.
WATCHDOG_CERT_PATH=
WATCHDOG_CERT_EXPIRY_DAYS=7
WATCHDOG_BACKUP_MAX_AGE_HOURS=26    # сутки + запас на дрейф крона

# --- Служебный smoke-набор (07 §6) ------------------------------------------
# `python -m app.cli seed-smoke` создаёт их идемпотентно после миграций.
# Домен .local зарезервирован: такой пользователь скрыт из списков сотрудников,
# выбора исполнителя и статистики.
SMOKE_USER_EMAIL=smoke@leadpartner.local
# Вторая учётка — роль `head`, ею проверка SM-10 читает список каналов Авито.
# Почему не `admin`: пароль лежит здесь же, поэтому берём меньшую из ролей,
# где есть `accounts:read` (разбор — в `cli._seed_smoke_admin`).
SMOKE_ADMIN_EMAIL=smoke-admin@leadpartner.local
SMOKE_CONVERSATION_EXTERNAL_ID=SMOKE-CONV
SMOKE_ACCOUNT_TITLE=SMOKE-ACCOUNT
SMOKE_AVITO_USER_ID=1

# ⚠ ПАРОЛИ ПРОВЕРОК — ЭТО ПЕРЕКЛЮЧАТЕЛЬ ГЕЙТА ВЫКАТКИ, А НЕ ПРОСТО СЕКРЕТ.
# Пока строки `SMOKE_PASSWORD=` ниже нет, `ship.sh` гоняет регрессию мягко и
# печатает жёлтое «пропущено проверок: 5». Как только учётки заданы, выкатка
# переходит в `--strict`, и любой SKIP означает откат образов. Поэтому
# раскомментировать их нужно ПОСЛЕ того, как ручной прогон
# `bash deploy/smoke.sh --strict` показал 11 pass / 0 skip, — иначе первая же
# выкатка откатит исправный образ из-за непроверяемой строки.
# SMOKE_EMAIL=smoke@leadpartner.local
# SMOKE_PASSWORD=
# SMOKE_ADMIN_PASSWORD=
# SMOKE_CONVERSATION_ID=            # id диалога SMOKE-CONV из вывода seed-smoke

# ============================================================================
# Быстрая генерация всех секретов разом (выполнить и вставить значения):
#
#   echo "POSTGRES_PASSWORD=$(openssl rand -base64 24 | tr -d '/+=' | head -c 24)"
#   echo "TOKEN_ENC_KEY=$(openssl rand -base64 32)"
#   echo "JWT_SECRET=$(openssl rand -base64 64 | tr -d '\n')"
#   echo "MEDIA_SIGN_KEY=$(openssl rand -hex 16)"
#
# После заполнения:  chmod 600 /opt/leadchat/.env
# Проверка, что ничего не забыто:  grep -n CHANGE_ME /opt/leadchat/.env
# ============================================================================
