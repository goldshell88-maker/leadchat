# ============================================================
# LeadChat — переменные окружения (dev, спринты 1–2)
# Скопируйте: cp .env.example .env — значения ниже работают
# из коробки с docker-compose.dev.yml.
# Имена переменных — источник истины docs/05-DEPLOY-OPS.md §4,
# менять нельзя: их читают Compose, CI и runbook.
# ============================================================

# --- Общее ---
APP_VERSION=dev                   # отдаётся в /api/health полем "version"
LOG_LEVEL=DEBUG                   # dev: DEBUG; в проде запрещён — только INFO (05 §4)

# --- PostgreSQL (docker-compose.dev.yml поднимает postgres:16 с этими кредами) ---
POSTGRES_DB=leadchat
POSTGRES_USER=leadchat
POSTGRES_PASSWORD=leadchat        # dev-значение; в проде: openssl rand -base64 24
# API запускается локально (make api) и ходит в published-порт контейнера;
# сервису api внутри compose DATABASE_URL переопределён на хост "postgres".
# async-драйвер обязателен (SQLAlchemy 2 async, DESIGN §2)
DATABASE_URL=postgresql+asyncpg://leadchat:leadchat@localhost:5432/leadchat

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Автораспределение обращений (docs/18) ----------------------------------
# Обращение само уходит наименее загруженному оператору, который СЕЙЧАС в сети
# и назначен на этот канал. Не нашлось такого — диалог остаётся в очереди
# «Входящие» ровно как раньше: распределение это слой НАД очередью, а не
# вместо неё, и его выключение не ломает ничего.
DISTRIBUTION_ENABLED=false
# Потолок одновременных диалогов на оператора. Закрытые не считаются: иначе
# закрывший за смену тридцать обращений к обеду выглядел бы самым занятым.
DISTRIBUTION_MAX_ACTIVE=5

# --- Auth (DESIGN §9) ---
JWT_SECRET=dev-only-jwt-secret-change-me   # прод: openssl rand -base64 64 (подпись access-JWT, HS256)
JWT_ACCESS_TTL_SECONDS=900                 # access-токен: 15 минут
REFRESH_TTL_DAYS=14                        # refresh-cookie: 14 дней, ротация + denylist в Redis

# --- Шифрование токенов Авито (DESIGN §1.5) ---
# 32 байта base64 для AES-256-GCM. Значение ниже — заглушка для разработки:
# она раскодируется в 32 байта, чтобы шифрование работало локально, и стоит
# в чёрном списке — при ENV=production Settings её отвергнет.
# Прод: openssl rand -base64 32
TOKEN_ENC_KEY=devOnlyKeyForLocalRunsNeverUseInProduction0=

# --- Авито: в dev смотрим в мок fake-avito (docker-compose.dev.yml, порт 8020) ---
# Реальные значения появятся только на проде (кабинет developers.avito.ru).
AVITO_API_BASE=http://localhost:8020
AVITO_AUTH_URL=http://localhost:8020/oauth
AVITO_CLIENT_ID=fake-client-id
AVITO_CLIENT_SECRET=fake-client-secret

# --- Медиа (05 §4) ---
# Подпись ссылок secure_link. Поле ОБЯЗАТЕЛЬНОЕ: без него приложение не
# поднимется. Раздача файлов идёт без входа по паролю — пропуском служит
# подпись, поэтому пустой или общеизвестный ключ означает, что переписку
# клиентов может скачать кто угодно.
#
# Значение ниже — заглушка для разработки, и она специально в чёрном списке:
# при ENV=production Settings её отвергнет. Прод: openssl rand -hex 32
MEDIA_SIGN_KEY=dev-media-sign-key

# Каталог вложений. Дефолт в коде — /var/leadchat/media (прод); при локальном
# запуске (make api) писать туда нельзя без root, и POST /api/v1/media отдаёт
# 500 «Хранилище вложений недоступно». Поэтому в dev — относительный путь
# рядом с репозиторием (создаётся автоматически при первой загрузке).
# Контейнерному режиму compose переопределяет значение на /var/leadchat/media
# (том leadchat_media, docker-compose.dev.yml).
MEDIA_ROOT=./var/media
MEDIA_MAX_SIZE_MB=20              # обязано совпадать с client_max_body_size в nginx

# --- Расшифровка голосовых (свой Whisper) ---
# Владелец выбирал между облаком и своим сервером и выбрал свой: «давай свой
# Whisper». Запись клиента никуда не уходит, считает ВОРКЕР, у нас остаётся
# только текст. Замер боя: 597 голосовых за 60 дней, около десяти в сутки.
#
# WHISPER_ENABLED=0 полностью выключает расшифровку: задача завершается сразу,
# ни модель, ни запись не трогаются. В dev по умолчанию именно 0 — первое же
# голосовое качает 464 МБ весов, а на машине разработчика это редко то, чего
# он ждал. На проде (.env.prod.example) стоит 1.
WHISPER_ENABLED=0
WHISPER_MODEL=small
# Потоков счёта. Два из четырёх ядер: столько же, сколько квота контейнера
# воркера (cpus: 2.0). Больше — и cgroup замораживает контейнер целиком,
# вместе с приёмом вебхуков Авито, который живёт в этом же процессе.
WHISPER_CPU_THREADS=2
# Куда качаются веса. В образе их нет намеренно (464 МБ через тоннель на каждой
# выкатке); в проде сюда смонтирован постоянный том.
WHISPER_MODEL_DIR=./var/whisper
# Записи длиннее порога не расшифровываются: потолок ARQ-задачи 300 с, и
# пятнадцатиминутную запись он убил бы на середине.
WHISPER_MAX_AUDIO_SECONDS=300
WHISPER_MAX_TRIES=3

# --- AI (боты, 02 §3) ---
# Вызовы Claude идут ТОЛЬКО из воркера. Без ключа шаг ai_answer штатно
# делает handoff(ai_unavailable) — бот не ломается, диалог уходит оператору.
# Ключи провайдеров адреса (DaData, Яндекс, контакт для OSM), читателей
# (OpenRouter, Groq, Mistral) и Anthropic здесь НЕ лежат с 16.09: все походы
# идут через шлюз на Амстердаме (GATEWAY_URL ниже, docs/46-ШЛЮЗ-API.md), ключи
# — в его /opt/leadchat-gateway/.env. Ниже — только модели и бюджеты ботов.
AI_MODEL_ANSWER=claude-sonnet-5
AI_MODEL_CLASSIFY=claude-haiku-4-5
AI_TIMEOUT_SECONDS=10
AI_MAX_TOKENS_ANSWER=1024
AI_MAX_TOKENS_CLASSIFY=256
# 1 — детерминированные ответы без единого сетевого вызова. Так работает CI:
# ни один тест не имеет права пойти в сеть.
AI_FAKE=1

# --- Лид-бот как поставщик ответов на шаге ai_answer (docs/42) ---
# ЗАПАСНЫЕ значения: адрес и токен живут в базе и меняются из интерфейса, а эти
# две строки задают стартовое состояние при развёртывании.
# ⚠ Заполненность САМА ПО СЕБЕ ничего не включает: поставщик выбирается у бота
# (bots.ai_provider, по умолчанию claude). Токен — только латиница: заголовки
# HTTP не переносят кириллицу, и с русской «с» каждый диалог уйдёт человеку.
LEADBOT_URL=
LEADBOT_TOKEN=

# --- Шлюз внешних API на Амстердаме (docs/46-ШЛЮЗ-API.md) ---
# Все походы к DaData/OSM/Яндексу/Ahunter/Спеллеру/читателям адреса/Anthropic идут
# через него; ключи провайдеров лежат только там. Пусто = помощники выключены.
GATEWAY_URL=                         # напр. http://10.10.0.2:8792 (адрес внутри моста)
GATEWAY_TOKEN=                       # GATEWAY_TOKEN из /opt/leadchat-gateway/.env

# --- CORS ---
# dev-фронтенд Vite живёт на 5173; в проде SPA и API на одном домене — CORS не нужен.
# Спринт 1: CORS для http://localhost:5173 включается в app/main.py при ENV=development.
CORS_ORIGINS=http://localhost:5173

# --- Кто ещё может открывать WebSocket, кроме самого сайта (аудит 01.09) ---
# Браузер шлёт Origin при рукопожатии всегда, поэтому чужая страница видна по
# нему. Свой домен разрешён сам собой (сравнивается с Host), а здесь —
# исключения. Tauri обязателен: десктоп грузит фронт локально, и его origin не
# наш домен. Три формы — потому что разные версии и системы представляются
# по-разному.
WS_EXTRA_ORIGINS=tauri://localhost,https://tauri.localhost,http://tauri.localhost

# --- Спринт 2: приём сообщений (DESIGN §8.3, docs/08 §1.3, 05 §4) ---
# База публичного URL для регистрации вебхука: бэкенд отдаёт Авито
# PUBLIC_BASE_URL + /api/hooks/avito/{account_id}?secret=...
# Локальный запуск (make api): fake-avito живёт в Docker и доставляет вебхуки
# на хост через host.docker.internal. Контейнерному api compose переопределяет
# значение на http://api:8000 (docker-compose.dev.yml). Прод: https://chat.partner-lead-centre.ru
PUBLIC_BASE_URL=http://host.docker.internal:8000

# База URL ФРОНТЕНДА: сюда бэкенд редиректит после OAuth-callback Авито и любых
# других возвратов в UI. Раньше адрес фронта был зашит в коде — теперь только
# отсюда (05 §4; прод-значение — в .env.prod.example).
# dev: Vite-сервер; прод: https://chat.partner-lead-centre.ru
FRONTEND_BASE_URL=http://localhost:5173

# Куда 302-ит страница-заглушка fake-avito /oauth после выдачи code.
# 01 §4.3: callback — публичный endpoint БЭКЕНДА (браузер админа приходит с Авито),
# затем сам бэкенд 302-ит на /settings/accounts?connected=1.
AVITO_REDIRECT_URI=http://localhost:8000/api/v1/avito/callback

# Reconciliation-поллинг — страховка недоставленных вебхуков (DESIGN §1.3, 08 §4.1)
RECONCILE_INTERVAL_SECONDS=300

# Как часто сторож поднимает каналы, у которых история загружена не целиком.
# Реже сверки намеренно: заходы загрузки идут в том же воркере, что доставка
# исходящих, и живая работа не должна ждать за прошлогодней перепиской.
BACKFILL_SUPERVISE_INTERVAL_SECONDS=300

# --- Протокольные тайминги и лимиты (01 §4.3, §10, §11) ---
WEBHOOK_MAX_BODY_BYTES=1048576             # шлюз вебхуков: потолок тела (01 §10)
WEBHOOK_RATE_LIMIT_PER_SECOND=50           # анти-шторм на аккаунт (01 §10)
WEBHOOK_STREAM_MAXLEN=100000               # потолок стрима webhooks:avito (XADD MAXLEN ~)
WEBHOOK_RAW_LOG_TTL_DAYS=7                 # хранение сырых вебхуков для разбора
AUDIT_LOG_TTL_DAYS=365                     # журнал действий; переписка не убирается никогда
MESSAGE_IDEMPOTENCY_TTL_DAYS=30            # второй эшелон от дублей исходящих
WS_TICKET_TTL_SECONDS=60                   # одноразовый тикет WS (01 §11.1)
WS_HEARTBEAT_TIMEOUT_SECONDS=60            # «ни одного кадра за N с» → 4408 (01 §11.5)
WS_PRESENCE_TTL_SECONDS=90                 # presence:{user_id} (01 §11.6)
WS_PRESENCE_OFFLINE_GRACE_SECONDS=15       # grace перед offline (перезагрузка вкладки)

# --- Пул соединений (05 §4; имена env — контракт) ---
# Все значения ниже равны дефолтам кода: строки нужны, чтобы имя переменной
# было видно в контракте, а не только в app/core/config.py.
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT_SECONDS=30
# 7200: холодное соединение стоит 40–62 мс планирования по 28 партициям
# `messages` (замер 06.09); от мёртвых соединений страхует pool_pre_ping.
DB_POOL_RECYCLE_SECONDS=7200
DB_IDLE_IN_TRANSACTION_TIMEOUT_MS=300000   # прод-страховка от «idle in transaction»
DB_STATEMENT_TIMEOUT_MS=0                  # 0 = без ограничения (миграции, бэкфилл)
# Потолок ОДНОГО запроса в веб-процессе. Отдельно от общего: за веб-запросом сидит
# человек, долгого дела у запроса нет, а один застрявший занимает соединение из
# пула в десять и морит голодом всех — вплоть до приёма сообщений от Авито
# (замер 02.09: 105 потерянных вебхуков из 566). Фоновых процессов не касается.
DB_API_STATEMENT_TIMEOUT_MS=15000

# Потолки на разговор с Redis. Без них `await` не возвращается никогда, если
# Redis замолчал, а не оборвал соединение, — и держит вместе с собой соединение
# к БД, потому что обработчик запроса занимает оба.
REDIS_SOCKET_TIMEOUT_SECONDS=3
REDIS_CONNECT_TIMEOUT_SECONDS=2
# Потолок ответа Redis у ВОРКЕРА — больше веб-процессного НАРОЧНО.
# Воркер читает поток командой, которая ждёт нарочно: XREADGROUP ... BLOCK 5000.
# Если потолок сокета меньше этого ожидания, сокет сдаётся раньше, чем отвечает
# Redis: каждый холостой заход цикла приёма кончается TimeoutError и
# переподключением (в бою 03.09 — 163 трассировки за двадцать минут).
# Правило: это число обязано быть больше inbound.READ_BLOCK_MS с запасом.
REDIS_BLOCKING_SOCKET_TIMEOUT_SECONDS=10

# --- Пер-юзерные read-маркеры (01 §5.1) ---
READ_MARKER_TTL_DAYS=90

# --- Пороги /api/health/deep (05 §7.2) ---
HEALTH_QUEUE_LEN_RED=1000
HEALTH_OLDEST_PENDING_SEC_RED=300
HEALTH_FAILED_LAST_HOUR_RED=10
# Доля занятого пула, с которой /health/deep краснеет. 0.8, а не 1.0: к моменту
# полного исчерпания запросы уже стоят в очереди по 30 с. Правило появилось
# после 02.09, когда сторож писал «OK» в минуты потери 105 вебхуков Авито.
HEALTH_POOL_BUSY_RED=0.8

# С какой длительности запрос пишется предупреждением, а не строкой info.
# Порог, а не «всё подряд предупреждениями»: если предупреждение у каждого
# запроса, то предупреждений нет вовсе.
SLOW_REQUEST_MS=1000
# Сколько держать «красное» после потери вебхука (webhooks:avito:dlq).
# Порога «сколько потерь считать бедой» нет — красное с первой записи; гасит
# только время. Сутки: поток никем не подрезается, и вечное красное сделало бы
# /deep бесполезным. Само число потерь из ответа не исчезает никогда.
HEALTH_DLQ_FRESH_SEC_RED=86400
HEALTH_DEEP_CHECK_SCHEDULER=false          # в проде — true
SCHEDULER_HEARTBEAT_MAX_AGE_SECONDS=300

# --- Служебный вход для скриптов на хосте (14 §2.1) ---
# Токен ручки POST /api/v1/internal/notify (её зовут deploy/backup.sh и внешний
# наблюдатель). Пусто = ручка выключена и отвечает 401 всем.
INTERNAL_SERVICE_TOKEN=

# --- Внешний сторож (14 §2.1) ---
# Все значения ниже равны дефолтам кода — строки нужны, чтобы имя переменной
# было видно в контракте окружения.
# Тишина по аккаунту в рабочие часы. ЧЕТЫРЕ ЧАСА, А НЕ ПОЛЧАСА: подняли
# 9 августа по измерению живого потока, но поменяли только код — эта строка
# осталась получасовой и била его на бою полтора дня (см.
# MIN_INBOUND_STALL_MINUTES в app/scheduler/jobs/watchdog.py). Ниже 240
# сторож значение не примет и скажет об этом в журнал.
WATCHDOG_INBOUND_STALL_MINUTES=240
WATCHDOG_WORK_START_HOUR=9          # МСК: ночью тишина — норма
WATCHDOG_WORK_END_HOUR=21
WATCHDOG_QUEUE_BACKLOG_RED=         # пусто → HEALTH_QUEUE_LEN_RED
WATCHDOG_QUEUE_OLDEST_SEC_RED=      # пусто → HEALTH_OLDEST_PENDING_SEC_RED
WATCHDOG_DISK_USED_PCT_WARNING=85
WATCHDOG_DISK_USED_PCT_CRITICAL=95
WATCHDOG_DISK_PATH=                 # пусто → MEDIA_ROOT, иначе «/»
WATCHDOG_CERT_PATH=                 # пусто → /etc/letsencrypt/live/${DOMAIN}/fullchain.pem
WATCHDOG_CERT_EXPIRY_DAYS=7
WATCHDOG_BACKUP_MAX_AGE_HOURS=26    # сутки + запас на дрейф крона

# --- Служебный smoke-набор (07 §6) ---
# Домен .local зарезервирован: такой пользователь скрыт из UI-списков.
SMOKE_USER_EMAIL=smoke@leadpartner.local
SMOKE_ADMIN_EMAIL=smoke-admin@leadpartner.local   # роль head: ею SM-10 читает каналы
SMOKE_CONVERSATION_EXTERNAL_ID=SMOKE-CONV
SMOKE_ACCOUNT_TITLE=SMOKE-ACCOUNT
SMOKE_AVITO_USER_ID=1

# --- Тюнинг фоновых процессов (05 §4) ---
ARQ_MAX_JOBS=50                   # параллельных задач в worker

# --- Лид-бот как поставщик ответов вместо прямого вызова модели ---
# Пусто (по умолчанию) — шаг ai_answer ходит в Anthropic сам, как раньше.
# Заполнено — спрашивает лид-бота: у него роутеры по регламенту заказчика, ценовая
# лестница и явная эскалация с причиной и сроком. Переключение обратимо, правкой одной
# строки и перезапуском воркера. Адрес — только внутри приватного моста, наружу порт
# не проброшен; токен всё равно обязателен (туннель — транспорт, а не аутентификация).
LEADBOT_URL=                        # напр. http://10.10.0.2:8790
LEADBOT_TOKEN=                      # тот же LEADBOT_SERVICE_TOKEN, что в /etc/leadbot.env
